# 统一换行符：仓库内一律 LF，工作区按平台自动转换
* text=auto

# 源码与文本强制 LF
*.py    text eol=lf
*.gal   text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.bat   text eol=crlf

# 二进制资源不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.wav   binary
*.ogg   binary
*.mp3   binary
*.ttf   binary
*.ttc   binary
*.otf   binary
*.exe   binary
