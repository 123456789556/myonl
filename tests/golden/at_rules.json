{
  "version": 1,
  "cases": [
    {
      "name": "voice_basic",
      "script": "@label start\n@[林晚] 你又迟到了。\n@voice a.ogg\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "say",
          "char": "林晚",
          "text": "你又迟到了。",
          "line": 2
        },
        {
          "op": "voice",
          "sound": "a.ogg",
          "line": 3
        },
        {
          "op": "end",
          "line": 4
        }
      ]
    },
    {
      "name": "cg_basic",
      "script": "@label start\n@cg cg_雨夜\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "cg",
          "name": "cg_雨夜",
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "fg_basic",
      "script": "@label start\n@fg fg_雨\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "fg",
          "name": "fg_雨",
          "x": 0,
          "y": 0,
          "alpha": 1.0,
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "fg_xy_alpha",
      "script": "@label start\n@fg fg_雨 x=10 y=-8 alpha=0.5\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "fg",
          "name": "fg_雨",
          "x": 10,
          "y": -8,
          "alpha": 0.5,
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "fg_none_clear",
      "script": "@label start\n@fg 无\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "fg",
          "name": "无",
          "x": 0,
          "y": 0,
          "alpha": 1.0,
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "fg_none_alias",
      "script": "@label start\n@fg none\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "fg",
          "name": "无",
          "x": 0,
          "y": 0,
          "alpha": 1.0,
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "camera_pan_cn",
      "script": "@label start\n@camera pan 左 1.5\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "camera",
          "kind": "pan",
          "args": [
            "左",
            1.5
          ],
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "camera_pan_en",
      "script": "@label start\n@camera pan left 1.5\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "camera",
          "kind": "pan",
          "args": [
            "左",
            1.5
          ],
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "camera_zoom",
      "script": "@label start\n@camera zoom 1.0 1.3\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "camera",
          "kind": "zoom",
          "args": [
            1,
            1.3
          ],
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "camera_shake",
      "script": "@label start\n@camera shake 0.5 8\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "camera",
          "kind": "shake",
          "args": [
            0.5,
            8
          ],
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "camera_reset",
      "script": "@label start\n@camera reset 0.8\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "camera",
          "kind": "reset",
          "args": [
            0.8
          ],
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "transition_dissolve",
      "script": "@label start\n@transition dissolve 0.4\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "transition",
          "kind": "dissolve",
          "args": [
            0.4
          ],
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "transition_wipe",
      "script": "@label start\n@transition wipe 左 0.4\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "transition",
          "kind": "wipe",
          "args": [
            "左",
            0.4
          ],
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    },
    {
      "name": "transition_slide",
      "script": "@label start\n@transition slide right 0.6\n@end\n",
      "expect": [
        {
          "op": "label",
          "name": "start",
          "line": 1
        },
        {
          "op": "transition",
          "kind": "slide",
          "args": [
            "右",
            0.6
          ],
          "line": 2
        },
        {
          "op": "end",
          "line": 3
        }
      ]
    }
  ]
}
