# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与调试产物
.pytest_cache/
.screenshots/
screenshots/
saves/
.coverage
.coverage-summary.json
htmlcov/

# 生成物 / 运行时资产
assets/_generated/
build/
dist/
# 玩家模板（约 23MB 的预构建运行库，由 tools/build_player_template.py 生成）
engine/templates/player/
*.log
# 编辑器预览用的临时剧本（mkstemp 命名 tmpXXXXXXXX.gal，异常退出才可能残留）
tmp????????.gal

# 模型权重与大模型文件（体积大，不入库）
*.ckpt
*.safetensors
*.bin
*.pth
*.onnx

# 编辑器与系统
.idea/
# 环境变量未展开时误建的目录（如 %SystemDrive%/ProgramData/...）
%SystemDrive%/
.vscode/
.DS_Store
Thumbs.db

games/月光漫步/src/

# 参考材料（第三方源码 / 商业项目 / 视频，约 380MB，仅本地查阅，不入库）
p30-renpy-ref/

# 玩家运行期写的 settings.json 不入库（根目录那份是本地游玩产物）
settings.json
# 例外：示例工程 / 素材模板自带的默认 settings.json 属于源码，需随仓库分发
!games/*/settings.json
!作品/副产物/*/settings.json

# Trae HTML 分享缓存（工具产物，不入库）
.trae-html-share-packages/

# pytest 临时目录（tmp_path 基目录；跑测试时可能落在仓库根，绝不入库）
pytest-of-*/
pytest-*/
dist/android/
.venv_ci/

# 安卓壳：单文件 HTML 是 CI 产物（3 MB），工程和签名才入库
android/app/src/main/assets/index.html
android/.gradle/
android/build/
android/app/build/
android/local.properties

# 签名私钥：绝不入库。
# 公开仓库里放 p12 + 明文密码 = 任何人能签一个包名和签名都相同的 APK，
# 覆盖装在已装正版的手机上，把你的作品全带走。
# CI 需要它就从 repository secret 还原（见 .github/workflows/android-apk.yml）。
android/keystore/
*.p12
*.jks
*.keystore

# 凭据类，一律不进
*.key
key.properties
.env
.env.*
!.env.example
secrets.json

# 性能探针：脚本入库（可复用），跑出来的产物不入库
# 实测 4.16 MB 里约 4 MB 是 work_*/pack.html 与 results/*.json，每次跑都会重新生成
tools/perf_probe/work_*/
tools/perf_probe/results/
tools/perf_probe/*.pack.html
credentials.json

